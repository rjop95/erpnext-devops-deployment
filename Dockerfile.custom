FROM frappe/erpnext:v15.23.1

# Metadatos del contenedor
LABEL maintainer="DevOps Team"
LABEL project="ERPNext Microservices"

# Directorio de trabajo estándar de Frappe
WORKDIR /home/frappe/frappe-bench

# Verificación de salud del contenedor
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=40s \
  CMD python3 -c "import socket; s = socket.socket(); s.connect(('127.0.0.1', 8000)); s.close()" || exit 1

# Comando de ejecución por defecto (gunicorn backend)
CMD ["bench", "start"]